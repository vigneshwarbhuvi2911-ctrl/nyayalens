# LLM: auto (OpenAI if OPENAI_API_KEY is set, otherwise offline) | openai | azure | bedrock | mock
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4.1-mini
OPENAI_MODEL_LARGE=gpt-4.1

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_SMALL=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_LARGE=gpt-4.1

# Amazon Bedrock (LLM_PROVIDER=bedrock; build with WITH_BEDROCK=true; standard AWS credential chain)
BEDROCK_MODEL_SMALL=amazon.nova-lite-v1:0
BEDROCK_MODEL_LARGE=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
WITH_BEDROCK=false

# Fix "today" (YYYY-MM-DD) for demos, so deadlines are judged against that date; empty = real date
NYAYALENS_TODAY=
